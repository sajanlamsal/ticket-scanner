# Example environment file for production
# Copy to .env.local and update values

# Ticket generation secret (keep secret!)
TICKET_SECRET=your_secure_secret_here_change_in_production

# JWT secret for admin authentication (minimum 32 characters)
ADMIN_JWT_SECRET=your_jwt_secret_here_at_least_32_chars_change_in_production

# Database configuration
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/tickets

# Valid domain for QR codes
# Development: localhost:3000
# Production: your-domain.com or tickets.your-domain.com
NEXT_PUBLIC_VALID_DOMAIN=your-domain.com

# Examples for different environments:
# Development: NEXT_PUBLIC_VALID_DOMAIN=localhost:3000
# Staging: NEXT_PUBLIC_VALID_DOMAIN=staging.your-domain.com  
# Production: NEXT_PUBLIC_VALID_DOMAIN=tickets.your-domain.com